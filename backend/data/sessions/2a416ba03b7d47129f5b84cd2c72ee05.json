    {
      "id": "f3b07b6ad3414651b0b723db808262c4",
      "role": "assistant",
      "content": "Welcome aboard! Let's get your finance pipeline set up.",
      "meta": {
        "kind": "welcome",
        "upload_offer": null
      }
    },
    {
      "id": "dde6346bb0f14ca9939544a83e29f9dd",
      "role": "user",
      "content": "I'm an AR collections analyst on the O2C team.",
      "meta": {}
    },
    {
      "id": "c7b63b86e5e74283ba47b2e90618e0bd",
      "role": "assistant",
      "content": "Got it, AR collections on O2C! What industry does your company operate in?",
      "meta": {
        "kind": "onboarding",
        "upload_offer": null
      }
    },
    {
      "id": "2b22e887ef3f41ddb44131268ddb33a2",
      "role": "user",
      "content": "Manufacturing \u2014 mid-market industrial, USD only.",
      "meta": {}
    },
    {
      "id": "eca5032cb0dc48faac213e2829925112",
      "role": "assistant",
      "content": "Thanks for sharing, mid-market industrial manufacturing is a great fit. What are your main AI priorities for streamlining your AR collections right now?",
      "meta": {
        "kind": "onboarding",
        "upload_offer": null
      }
    },
    {
      "id": "332cf1da45dd425687b9e0542c14dcfb",
      "role": "user",
      "content": "Confirm which customer invoices actually got paid from the bank feed, and surface shorts and unpaid items.",
      "meta": {}
    },
    {
      "id": "e71afea73b3f4e75a2d2da31df50a647",
      "role": "assistant",
      "content": "Automating invoice matching against bank feeds will save your team serious time. Could you describe your current workflow for handling short pays and unpaid items?",
      "meta": {
        "kind": "onboarding",
        "upload_offer": null
      }
    },
    {
      "id": "275fa16f877d4732ad03e2271510c6ee",
      "role": "user",
      "content": "Invoice payment confirmation. Match bank statement receipts to the customer invoice register by customer name, check whether the amount paid matches the invoice total, and tell me for each invoice if it is paid, short, overpaid, or not paid.",
      "meta": {}
    },
    {
      "id": "9b90a09526694ed89161bd62a5070917",
      "role": "assistant",
      "content": "That workflow gives us a clear picture of your reconciliation process. Would you like to upload your sample bank statement and invoice register files now?",
      "meta": {
        "kind": "onboarding",
        "upload_offer": "data"
      }
    },
    {
      "id": "6f20ff99d86d4b17941d30b5830e0977",
      "role": "user",
      "content": "Attached working files: Bank_Statement_June.xlsx, Customer_Invoices.xlsx",
      "meta": {
        "kind": "upload",
        "upload_kind": "data",
        "files": [
          {
            "name": "Bank_Statement_June.xlsx",
            "file_id": "Bank_Statement_June"
          },
          {
            "name": "Customer_Invoices.xlsx",
            "file_id": "Customer_Invoices"
          }
        ]
      }
    },
    {
      "id": "a053b66b137747d9a17fe0c75c17b06d",
      "role": "assistant",
      "content": "Thanks for uploading those files, I have successfully reviewed your bank statements and customer invoices. Do you have any standard operating procedures or policy guidelines for handling short pays that I should keep in mind?",
      "meta": {
        "kind": "onboarding",
        "upload_offer": "knowledge"
      }
    },
    {
      "id": "7b2ff131cef94b968620877409367264",
      "role": "user",
      "content": "Attached reference document: AR_Collections_Policy.pdf",
      "meta": {
        "kind": "upload",
        "upload_kind": "knowledge",
        "files": [
          {
            "name": "AR_Collections_Policy.pdf",
            "file_id": "AR_Collections_Policy"
          }
        ]
      }
    },
    {
      "id": "2cae5e23a6fd4b7d856e6c561255b8b5",
      "role": "assistant",
      "content": "Thanks for providing that policy document, it gives me everything needed regarding tolerances and expected outcomes.\n\nWhen you line these files up, which fields tell you it's the same item?",
      "meta": {
        "kind": "turn",
        "ready": false,
        "question_count": 1
      }
    },
    {
      "id": "9d7f39342fd34aebbff752a7e65a4441",
      "role": "user",
      "content": "Pair on customer name. Bank lockbox names are messy \u2014 Northwind Wholesale Inc may show as NORTHWIND WHSLE CO. Do not use amount as a match key because shorts still need to pair.",
      "meta": {}
    },
    {
      "id": "b49025285c7c4d069547a30157faf701",
      "role": "assistant",
      "content": "Got it, we'll match using customer name while accommodating those naming variations.\n\nIf the numbers are a little off, how much difference is still acceptable?",
      "meta": {
        "kind": "turn",
        "ready": false,
        "question_count": 2
      }
    },
    {
      "id": "4c53dec4de284f8aaf242ecead22243a",
      "role": "user",
      "content": "After the name match, compare invoice total to the amount received. Allow the lesser of one percent of the invoice or fifty dollars. Ten dollars under is fine; thousands under is not.",
      "meta": {}
    },
    {
      "id": "ea64a6492238401cbb8602d9826d3171",
      "role": "assistant",
      "content": "That covers our tolerance rules nicely, capturing both the percentage and dollar limits.\n\nWhat should happen to rows that don't match or sit outside that range?",
      "meta": {
        "kind": "turn",
        "ready": false,
        "question_count": 3
      }
    },
    {
      "id": "c9b61de6198148329552b14c453f5960",
      "role": "user",
      "content": "One invoice can be paid with two deposits. Match them as a group. If cash is left over or a second full payment lands, call it out.",
      "meta": {}
    },
    {
      "id": "a10f0c7c6ed34c1db083db9fd03f4740",
      "role": "assistant",
      "content": "That covers grouping multi-deposit payments and handling leftovers cleanly.\n\nWho should review exceptions, and is there anything you can auto-approve?",
      "meta": {
        "kind": "turn",
        "ready": false,
        "question_count": 4
      }
    },
    {
      "id": "5a1b2228173246d68496c16bc939e580",
      "role": "user",
      "content": "Anything unpaid more than thirty days past due is collections. Cite the AR policy so the reviewer knows why.",
      "meta": {}
    },
    {
      "id": "cc11b7bd5d0e4e43aac42ddd88c1d5a0",
      "role": "assistant",
      "content": "Thanks for citing the collections timeline and policy rule to guide our reviewer.\n\nWhat should I hand you at the end \u2014 Excel, PDF, or both?",
      "meta": {
        "kind": "turn",
        "ready": false,
        "question_count": 5
      }
    },
    {
      "id": "3b47e6765cc84ed0bc03b3358c274b38",
      "role": "user",
      "content": "Excel workbook I can download \u2014 a sheet for paid, a sheet for partials, a sheet for exceptions. No Slack.",
      "meta": {}
    },
    {
      "id": "0d1675ecb9f84459bf8efe6770090e32",
      "role": "assistant",
      "content": "Got it, we'll output the cleanly separated sheets straight to Excel as requested.\n\nAR collections pipeline matching bank statement receipts to customer invoice registers, checking tolerances, applying past-due escalation policies, and outputting to a structured Excel workbook.\n\nWhy this pipeline\n\u2022 Invoice payment confirmation. Match bank statement receipts to the customer invoice register by customer name, check whether the amount paid matches the invoice total, and tell me for each invoice if it is paid, short, overpaid, or not paid.\n\nWhat each step does\n1. Bank_Statement_June \u2014 Reads working file Bank_Statement_June.xlsx and detects its columns.\n2. Customer_Invoices \u2014 Reads working file Customer_Invoices.xlsx and detects its columns.\n3. AR_Collections_Policy \u2014 Reads the policy/reference file AR_Collections_Policy.pdf and keeps the rules for matching and review.\n4. Matcher \u2014 Pairs rows that share Customer Name. Dates may drift by 30 day(s). Leftovers and splits go to exceptions.\n5. Math \u2014 Applies: abs(actual - expected) > min(0.01 * expected, 50.00).\n6. Decision \u2014 Flags or approves using: Anything unpaid more than thirty days past due is collections, citing the AR policy..\n7. Output \u2014 Builds a Excel report you can download.\n\nRead this through. If it matches what you need, confirm the pipeline \u2014 then Save it to the library to run it.",
      "meta": {
        "kind": "turn",
        "ready": true,
        "question_count": 5
      }
    },
    {
      "id": "472416ee2ae246f895ba9bf98e8f3d41",
      "role": "assistant",
      "content": "Confirmed.\n\nWhy this pipeline\n\u2022 Invoice payment confirmation. Match bank statement receipts to the customer invoice register by customer name, check whether the amount paid matches the invoice total, and tell me for each invoice if it is paid, short, overpaid, or not paid.\n\nWhat each step does\n1. Bank_Statement_June \u2014 Reads working file Bank_Statement_June.xlsx and detects its columns.\n2. Customer_Invoices \u2014 Reads working file Customer_Invoices.xlsx and detects its columns.\n3. AR_Collections_Policy \u2014 Reads the policy/reference file AR_Collections_Policy.pdf and keeps the rules for matching and review.\n4. Matcher \u2014 Pairs rows that share Customer Name. Dates may drift by 30 day(s). Leftovers and splits go to exceptions.\n5. Math \u2014 Applies: abs(actual - expected) > min(0.01 * expected, 50.00).\n6. Decision \u2014 Flags or approves using: Anything unpaid more than thirty days past due is collections, citing the AR policy..\n7. Output \u2014 Builds a Excel report you can download.\n\nNext: Save this to the Super Agents library. You run it from the library with files that use the same names (values can change).",
      "meta": {
        "kind": "confirm"
      }
    }
  ],
  "requirements": [
    {
      "id": "req_match_1",
      "kind": "match",
      "value": {
        "window_days": 30,
        "keys": [
          "Customer Name"
        ],
        "flags": {
          "allocation": true,
          "group_receipts": true,
          "receipts_only": true
        },
        "mode": "fuzzy"
      },
      "source_message_id": "3b47e6765cc84ed0bc03b3358c274b38"
    },
    {
      "id": "req_math_1",
      "kind": "math",
      "value": {
        "constants": {
          "pct": 0.01,
          "amount": 50.0
        },
        "gate_ast": "abs(actual - expected) > min(pct * expected, amount)",
        "ast": "abs(actual - expected)",
        "output_column": "over_tolerance",
        "formula_en": "abs(actual - expected) > min(0.01 * expected, 50.00)",
        "mode": "hybrid",
        "catalog_id": "min_pct_amount_tolerance",
        "compiled_from": "abs(actual - expected) > min(0.01 * expected, 50.00)",
        "input_map": {
          "actual": "Amount",
          "expected": "Invoice Total"
        },
        "shape": "sequential"
      },
      "source_message_id": "3b47e6765cc84ed0bc03b3358c274b38"
    },
    {
      "id": "req_decision_1",
      "kind": "decision",
      "value": {
        "policy": "Anything unpaid more than thirty days past due is collections, citing the AR policy."
      },
      "source_message_id": "3b47e6765cc84ed0bc03b3358c274b38"
    },
    {
      "id": "req_output_1",
      "kind": "output",
      "value": {
        "formats": [
          "xlsx"
        ]
      },
      "source_message_id": "3b47e6765cc84ed0bc03b3358c274b38"
    }
  ],
