        "formula_en": "abs(actual - expected) > min(0.01 * expected, 50.00)"
      },
      "source_message_id": "d5cd4919b73540e5ae60b0bc760dd415"
    },
    {
      "id": "req_decision_1",
      "kind": "decision",
      "value": {
        "policy": "Anything unpaid more than thirty days past due is collections. Cite the AR policy so the reviewer knows why."
      },
      "source_message_id": "d5cd4919b73540e5ae60b0bc760dd415"
    },
